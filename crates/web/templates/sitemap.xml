<?xml version="1.0" encoding="UTF-8"?>
{% if index %}<sitemapindex xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">{% for url in urls %}<sitemap><loc>{{ url }}</loc></sitemap>{% endfor %}</sitemapindex>{% else %}<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">{% for url in urls %}<url><loc>{{ url }}</loc></url>{% endfor %}</urlset>{% endif %}
